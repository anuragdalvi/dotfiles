// Optional VS Code terminal text-editing parity with iTerm and Zsh ZLE.
// tmux or Herdr, not VS Code terminal panes, owns workspace navigation.
// Sequences match iTerm "Natural Text Editing": ESC=u001b A=u0001 E=u0005 DEL=u007f U=u0015
[
    // Shell editing only outside full-screen programs' alternate screen.
    {
        "key": "alt+left",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001bb"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "alt+right",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001bf"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "cmd+left",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0001"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "cmd+right",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0005"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "alt+backspace",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\u007f"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "cmd+backspace",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0015"
        },
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "ctrl+left",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001bb"
        },
        "when": "terminalFocus && !terminalAltBufferActive && isLinux"
    },
    {
        "key": "ctrl+right",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001bf"
        },
        "when": "terminalFocus && !terminalAltBufferActive && isLinux"
    },
    {
        "key": "ctrl+backspace",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\u007f"
        },
        "when": "terminalFocus && !terminalAltBufferActive && isLinux"
    },
    // -- Terminal-local actions --
    {
        "key": "cmd+k",
        "command": "workbench.action.terminal.clear",
        "when": "terminalFocus && !terminalAltBufferActive"
    },
    {
        "key": "cmd+w",
        // Hide the panel while leaving its terminals and processes running.
        "command": "workbench.action.togglePanel",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+d",
        "command": "workbench.action.terminal.split",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+alt+left",
        "command": "workbench.action.terminal.focusPreviousPane",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+alt+right",
        "command": "workbench.action.terminal.focusNextPane",
        "when": "terminalFocus"
    }
]
