{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "context": {
    "includeGitIgnore": true,
    "maxHistoryMessages": 3,      // Stops the agent from remembering long chat history
    "maxTotalTokens": 8000        // Set a hard stop for payload size per turn
  }
}
